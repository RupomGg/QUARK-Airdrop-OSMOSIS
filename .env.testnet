# Osmosis TESTNET (osmo-test-5) configuration — for dry-running the airdrop
# fix with free test tokens before touching mainnet. Completely separate
# wallet from the real .env treasury; safe to share/regenerate, holds no
# real value. Fund this address at https://faucet.testnet.osmosis.zone
# before testing.
#
# DO NOT use this file for production. Run it with:
#   node --env-file=.env.testnet node_modules/vite/bin/vite.js dev
# (or `npm run dev:testnet` if you add the script below to package.json)

OSMO_TREASURY_MNEMONIC="trade proof expand pilot crater layer swift satisfy bounce this buddy firm turn chunk spread flower anger hello rail walk antenna antenna horn second"
VITE_TREASURY_ADDRESS="osmo122gaydjxh50pqpqhzdkz2sfsjvpw0x6xtfztmc"

# Server-side (read via process.env) — used for signing/broadcasting.
OSMO_RPC_URL=https://rpc.testnet.osmosis.zone
OSMO_LCD_URL=https://lcd.testnet.osmosis.zone
OSMO_CHAIN_ID=osmo-test-5
OSMO_CHAIN_NAME="Osmosis Testnet"

# Client-side (must be VITE_-prefixed to reach the browser bundle) — used by
# Keplr chain-suggestion (connectKeplr/suggestToken) so the wallet UI talks
# to the same testnet, not mainnet.
VITE_OSMO_RPC_URL=https://rpc.testnet.osmosis.zone
VITE_OSMO_LCD_URL=https://lcd.testnet.osmosis.zone
VITE_OSMO_CHAIN_ID=osmo-test-5
VITE_OSMO_CHAIN_NAME="Osmosis Testnet"

ALLOW_VOUCHER_REAL_PAYOUT=false


TEST_WALLET = "sort sheriff put interest congress lamp cushion core recycle wrestle copy honey survey combine guilt execute trash outdoor embark eyebrow off escape usage sword"
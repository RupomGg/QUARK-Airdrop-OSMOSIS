# Osmosis Protocol Treasury Configuration
# Copy this file to '.env' and fill in the values below.
# DO NOT commit the '.env' file containing real secrets to version control.

# The 24-word seed phrase of the treasury wallet used to sign on-chain transactions
OSMO_TREASURY_MNEMONIC=""

# The public address of the treasury wallet (exposed to the client UI)
VITE_TREASURY_ADDRESS=""
